# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace every PLACEHOLDER value.
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore. Never commit it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# REQUIRED: one model provider key
# ---------------------------------------------------------------------------
# Needed if `llm.model` or `event.effects_generator_model` in config.yaml is an
# OpenAI model (anything starting with "gpt-"). Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# Needed if `llm.model` in config.yaml is an Anthropic model (anything with
# "claude" in the name). Get one at https://console.anthropic.com/settings/keys
# Leave as-is if you are only using OpenAI models.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# ---------------------------------------------------------------------------
# OPTIONAL: Flask session signing key
# ---------------------------------------------------------------------------
# If unset, a random key is generated at startup, which logs every participant
# out whenever the server restarts. Set it for anything beyond local testing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_WITH_A_RANDOM_HEX_STRING

# ---------------------------------------------------------------------------
# OPTIONAL: MongoDB, for saving what participants write
# ---------------------------------------------------------------------------
# Without these the app still runs: participants can write and get suggestions,
# but nothing is recorded. Any MongoDB connection string works (MongoDB Atlas
# has a free tier).
#
# Used when running locally (not deployed):
MONGO_WORKING_STAGE_URL=mongodb+srv://USERNAME:PASSWORD@REPLACE_WITH_YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Used when deployed. On Railway this is the variable the app reads, so set it
# per environment (a separate database for staging and production).
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@REPLACE_WITH_YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Only read by mongo_util.retrieve_database_data(), for pulling data back out of
# a deployed environment from your own machine.
MONGO_STAGING_URL=mongodb+srv://USERNAME:PASSWORD@REPLACE_WITH_YOUR_STAGING_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_PRODUCTION_URL=mongodb+srv://USERNAME:PASSWORD@REPLACE_WITH_YOUR_PRODUCTION_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# OPTIONAL: Slack alerts on model API errors
# ---------------------------------------------------------------------------
# An incoming-webhook URL. If unset, alerts are skipped silently. Throttled by
# `autocomplete.alert_throttle_minutes` in config.yaml.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=REPLACE_WITH_YOUR_SLACK_WEBHOOK_URL
